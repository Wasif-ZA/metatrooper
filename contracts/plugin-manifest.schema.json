{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metatrooper.dev/schema/plugin/v1.json",
  "title": "MetaTrooper plugin manifest (troop-plugin.json), version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "maxLength": 80 },
    "description": { "type": "string", "maxLength": 400 },
    "platforms": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] }, "default": ["windows"] },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(project:read|project:write|run:write|network|browser|clipboard|secrets:[A-Z][A-Z0-9_]{0,63})$" },
      "uniqueItems": true
    },
    "engines": { "type": "array", "items": { "$ref": "#/$defs/engine" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "pipelines": { "type": "array", "items": { "type": "string", "description": "Paths to pipeline.json files inside the plugin." } },
    "panes": { "type": "array", "items": { "$ref": "#/$defs/pane" } },
    "mcp": { "type": "array", "items": { "$ref": "#/$defs/mcp" } },
    "pane_methods": {
      "description": "Core pipe methods the plugin's panes may call through the bridge.",
      "type": "array", "items": { "type": "string" }
    }
  },
  "$defs": {
    "argv": { "type": "array", "items": { "type": "string" } },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "version_cmd", "state_source", "roles", "cost_rank"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$" },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" }, "default": [] },
        "prompt_arg": {
          "description": "How to pass the first prompt. 'positional' appends it as the last argument; a string like '--prompt' passes it after that flag; omit if the CLI takes no prompt argument.",
          "type": "string"
        },
        "resume_args": { "type": "array", "items": { "type": "string" }, "description": "Arguments that resume an earlier session; {native_id} is replaced by its id. Omit if the CLI cannot resume." },
        "version_cmd": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "min_version": { "type": "string", "description": "Lowest version that works; an older one shows as too-old." },
        "install": { "type": "string", "description": "Install command shown when the engine is missing." },
        "login": { "type": "string", "description": "Login command shown when auth_cmd fails." },
        "auth_cmd": { "type": "array", "items": { "type": "string" } },
        "instructions_arg": { "type": "string", "description": "Flag that takes extra instruction text, e.g. --append-system-prompt. With sessions.metarouter on, sessions get the metarouter block through it." },
        "agents_md": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unless", "args"],
          "properties": {
            "unless": { "type": "array", "items": { "type": "string" }, "description": "Files in the session folder that make the engine skip AGENTS.md." },
            "args": { "type": "array", "items": { "type": "string" }, "description": "Arguments that make the engine read AGENTS.md." }
          }
        },
        "auth_ok": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exit_code": { "type": "integer", "default": 0 },
            "stdout_regex": { "type": "string" }
          },
          "description": "auth is 'ok' when auth_cmd exits with exit_code and, if given, stdout matches stdout_regex. Otherwise 'missing'. No auth_cmd means 'unknown'."
        },
        "state_source": { "enum": ["hooks", "notify", "file-activity", "process"] },
        "activity_glob": { "type": "string", "description": "Required when state_source is file-activity." },
        "activity_waiting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["last_line_regex"],
          "properties": { "file": { "type": "string" }, "last_line_regex": { "type": "string" } }
        },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file", "at", "path_style"],
          "properties": {
            "kind": { "enum": ["json-map", "json-list", "toml-table"] },
            "file": { "type": "string", "pattern": "^~/", "description": "Under the user's home." },
            "at": { "type": "array", "items": { "type": "string" } },
            "set": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "path_style": { "enum": ["posix", "windows", "windows-lower"] }
          }
        },
        "approval_profiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ask": { "$ref": "#/$defs/argv" }, "edits": { "$ref": "#/$defs/argv" },
            "contained": { "$ref": "#/$defs/argv" }, "isolated": { "$ref": "#/$defs/argv" }
          },
          "description": "Arguments per approval level. isolated is shown on the install screen as acting without asking."
        },
        "ask_near_paths": { "type": "boolean" },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "set"],
          "properties": {
            "file": { "type": "string", "pattern": "^~/", "description": "Under the user's home." },
            "set": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
          }
        },
        "print_args": { "type": "array", "items": { "type": "string" }, "description": "Headless run; {prompt} is replaced." },
        "sandbox": { "type": "object", "description": "Built-in engines only: how the trooper sandbox host installs and logs in the engine." },
        "mcp_attach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["claude-mcp-config-flag", "codex-config", "agy-config", "env-file", "env-json", "config-dir", "args-template", "none"] },
            "path": { "type": "string" },
            "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$", "description": "env-json: variable that receives the JSON. config-dir: variable that receives the folder." },
            "format": { "enum": ["mcpServers", "opencode-mcp"], "default": "mcpServers", "description": "Shape of the JSON written." },
            "template": { "type": "array", "items": { "type": "string" }, "description": "args-template: per server; {name}, {node}, {shim}, {plugin}, {server}, {url}." }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "enum": ["env-json", "config-dir"] } } }, "then": { "required": ["env"] } },
            { "if": { "properties": { "kind": { "const": "args-template" } } }, "then": { "required": ["template"] } }
          ]
        },
        "roles": { "type": "array", "items": { "enum": ["research", "plan", "worker", "review", "verify", "visual-check"] }, "minItems": 1 },
        "cost_rank": { "type": "integer", "minimum": 1, "maximum": 10 },
        "provider": { "enum": ["local-cli", "api-key", "gateway"], "default": "local-cli" },
        "usage_source": { "enum": ["claude-transcript", "codex-session", "none"], "default": "none" },
        "shift_enter": { "enum": ["paste", "alt-enter"], "default": "paste", "description": "What Shift+Enter sends: a bracketed paste of a newline, or ESC CR." }
      },
      "allOf": [
        { "if": { "required": ["state_source"], "properties": { "state_source": { "const": "file-activity" } } }, "then": { "required": ["activity_glob"] } }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "title": { "type": "string" },
        "run": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "argv, resolved relative to the plugin root. No shell." },
        "external": { "type": "boolean", "default": false, "description": "True if the action posts, sends, deploys, submits or spends money." },
        "destination_field": { "type": "string", "description": "Input field naming where an external action sends things (account, channel, recipient). Part of the gate action_hash." },
        "input_schema": { "type": "object", "description": "JSON Schema for the action input." },
        "output_schema": { "type": "object", "description": "JSON Schema for outputs." },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200, "default": 600 }
      },
      "allOf": [
        { "if": { "required": ["external"], "properties": { "external": { "const": true } } }, "then": { "required": ["destination_field"] } }
      ]
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "entry": { "type": "string", "description": "HTML file inside the plugin." }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "engines"],
      "allOf": [{ "if": { "required": ["transport"], "properties": { "transport": { "const": "http" } } }, "then": { "required": ["url"] }, "else": { "required": ["command"] } }],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "transport": { "enum": ["stdio", "http"], "default": "stdio" },
        "url": { "type": "string", "pattern": "^https://" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[^$]*(\\$\\{[A-Z][A-Z0-9_]{0,63}\\}[^$]*)+$" },
          "description": "Each value must contain at least one ${SECRET}, and the plugin needs secrets:SECRET. Literal values fail validation."
        },
        "auth": { "enum": ["none", "header", "engine-oauth"], "default": "none" },
        "writes": { "enum": ["none", "project", "external"], "description": "external: the server can post, send, create or spend outside the machine. An http server with no value counts as external." },
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "env_keys": { "type": "array", "items": { "type": "string" }, "description": "Each must also appear as secrets:<KEY> in permissions." },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Literal, non-secret environment values. A key also in env_keys is refused." },
        "engines": { "type": "array", "items": { "type": "string" }, "description": "Engine ids to attach to, or ['*']. Engines are given the mcp-shim command, never this command directly (plugins.md)." }
      }
    }
  }
}
