{
  "schema": 1,
  "id": "media",
  "version": "0.1.0",
  "name": "Media",
  "description": "Probes, downloads, transcribes with word times, cuts and captions video through ffmpeg, yt-dlp and whisper.cpp on this machine.",
  "platforms": ["windows"],
  "permissions": ["project:read", "run:write", "network"],
  "actions": [
    {
      "id": "probe",
      "title": "List takes with duration, size and audio",
      "run": ["bin/media.js", "probe"],
      "timeout_seconds": 120,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": { "path": { "type": "string", "minLength": 1, "description": "A media file or a folder of them." } }
      },
      "output_schema": { "type": "object", "required": ["files", "count"], "properties": { "files": { "type": "array" }, "count": { "type": "integer" }, "duration": { "type": "number" } } }
    },
    {
      "id": "transcribe",
      "title": "Transcribe with word times",
      "run": ["bin/media.js", "transcribe"],
      "timeout_seconds": 3600,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "out"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "out": { "type": "string", "minLength": 1 },
          "scenes": { "type": ["boolean", "string"] }
        }
      },
      "output_schema": { "type": "object", "required": ["out", "words"], "properties": { "out": { "type": "string" }, "words": { "type": "integer" }, "files": { "type": "integer" }, "skipped": { "type": "array" } } }
    },
    {
      "id": "download",
      "title": "Fetch the source video",
      "run": ["bin/media.js", "download"],
      "timeout_seconds": 1800,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "out"],
        "properties": { "source": { "type": "string", "minLength": 1, "description": "A local file or a video URL (yt-dlp)." }, "out": { "type": "string", "minLength": 1 } }
      },
      "output_schema": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "from": { "type": "string" } } }
    },
    {
      "id": "cut",
      "title": "Cut one approved moment",
      "run": ["bin/media.js", "cut"],
      "timeout_seconds": 600,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video", "moments", "out"],
        "properties": {
          "video": { "type": "string", "minLength": 1 },
          "moments": { "type": ["string", "array"], "description": "moments.json or its items; items with status approved are cut, else all." },
          "index": { "type": ["integer", "string"] },
          "aspect": { "type": "string", "enum": ["9:16", "1:1", "16:9"] },
          "out": { "type": "string", "minLength": 1 }
        }
      },
      "output_schema": { "type": "object", "properties": { "path": { "type": ["string", "null"] }, "id": { "type": "string" }, "seconds": { "type": "number" }, "skipped": { "type": "boolean" } } }
    },
    {
      "id": "captions",
      "title": "Burn captions and the hook",
      "run": ["bin/media.js", "captions"],
      "timeout_seconds": 600,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clip", "words", "out"],
        "properties": {
          "clip": { "type": ["string", "null"] },
          "words": { "type": "string", "minLength": 1 },
          "hook_seconds": { "type": ["number", "string"] },
          "out": { "type": "string", "minLength": 1 }
        }
      },
      "output_schema": { "type": "object", "properties": { "path": { "type": ["string", "null"] }, "id": { "type": "string" }, "skipped": { "type": "boolean" } } }
    }
  ]
}
