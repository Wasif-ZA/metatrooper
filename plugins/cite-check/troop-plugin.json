{
  "schema": 1,
  "id": "cite-check",
  "version": "0.1.0",
  "name": "Cite check",
  "description": "Checks every cited sentence in a report against its fetched source, and lists uncited factual sentences and dead links.",
  "platforms": ["windows", "linux", "macos"],
  "permissions": ["network", "run:write"],
  "actions": [
    {
      "id": "check",
      "title": "Check every citation",
      "run": ["bin/cite-check.js"],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["report", "sources"],
        "properties": {
          "report": { "type": "string", "minLength": 1, "description": "Markdown report; claims carry [s01] style markers." },
          "sources": { "type": "string", "minLength": 1, "description": "sources.json, or a folder holding it: a list of {id, url, title?, path?}; path is a saved copy relative to sources.json and is read instead of fetching url." },
          "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120, "default": 15 }
        }
      },
      "output_schema": {
        "type": "object",
        "required": ["passed", "claims_total", "bound", "unbound", "dead_links", "result_path"],
        "properties": {
          "passed": { "type": "boolean" },
          "claims_total": { "type": "integer" },
          "bound": { "type": "integer" },
          "unbound": { "type": "array", "items": { "type": "object", "required": ["line", "text", "reason"] } },
          "dead_links": { "type": "array", "items": { "type": "object", "required": ["id", "url", "error"] } },
          "result_path": { "type": "string" }
        }
      },
      "timeout_seconds": 600
    }
  ]
}
