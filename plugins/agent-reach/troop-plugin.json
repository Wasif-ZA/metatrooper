{
  "schema": 1,
  "id": "agent-reach",
  "version": "0.1.0",
  "name": "Agent-Reach",
  "description": "Research sources and the inspiration board, built on Agent-Reach 1.5.0 (Exa search through mcporter, GitHub search through gh).",
  "platforms": [
    "windows"
  ],
  "permissions": [
    "network",
    "run:write"
  ],
  "pipelines": [
    "pipelines/inspiration-board.json"
  ],
  "actions": [
    {
      "id": "inspiration-board",
      "title": "Find inspiration references for a brief",
      "run": [
        "bin/inspiration-board.js"
      ],
      "timeout_seconds": 180,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "brief"
        ],
        "properties": {
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 8,
            "maximum": 12,
            "default": 10
          },
          "github_query": {
            "type": "string"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "references"
        ],
        "properties": {
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_url",
                "title",
                "reason",
                "kind"
              ],
              "properties": {
                "source_url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "web",
                    "github"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "search",
      "title": "Search the plan's angles and save each source",
      "run": [
        "bin/search.js"
      ],
      "timeout_seconds": 600,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan",
          "out"
        ],
        "properties": {
          "plan": {
            "type": "string",
            "minLength": 1,
            "description": "plan.md; every line starting search: is one query."
          },
          "out": {
            "type": "string",
            "minLength": 1,
            "description": "Folder for sources.json and one sNN.txt per saved page."
          },
          "per_query": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "sources",
          "count",
          "saved"
        ],
        "properties": {
          "sources": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "saved": {
            "type": "integer"
          },
          "failed": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "sources",
      "title": "Fetch a few pages from each prospect site",
      "run": [
        "bin/search.js",
        "sources"
      ],
      "timeout_seconds": 1800,
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prospects",
          "out"
        ],
        "properties": {
          "prospects": {
            "type": "string",
            "minLength": 1,
            "description": "prospects.json: a list with site, name, business."
          },
          "max_pages": {
            "type": [
              "integer",
              "string"
            ]
          },
          "out": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "output_schema": {
        "type": "object",
        "required": [
          "out",
          "prospects",
          "pages"
        ],
        "properties": {
          "out": {
            "type": "string"
          },
          "prospects": {
            "type": "integer"
          },
          "with_pages": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
