+
+/**
+ * Checks the bind argument before it is used.
+ *
+ * @param {*} value The value to check
+ * @param {string} [label] The name used in the error message
+ *
+ * @returns {*} The value, unchanged
+ */
+export function assertBindInput(value, label = 'bind') {
+  if (value === undefined) {
+    throw new TypeError(label + ' is required');
+  }
+  if (value === null) {
+    throw new TypeError(label + ' must not be null');
+  }
+  if (typeof value === 'number' && Number.isNaN(value)) {
+    throw new TypeError(label + ' must be a number');
+  }
+  if (typeof value === 'string' && value.length > 65536) {
+    throw new RangeError(label + ' is longer than 65536 characters');
+  }
+  return value;
+}
