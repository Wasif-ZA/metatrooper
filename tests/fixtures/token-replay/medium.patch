diff --git a/lib/core/buildFullPath.js b/lib/core/buildFullPath.js
index b60927c..d7577f4 100644
--- a/lib/core/buildFullPath.js
+++ b/lib/core/buildFullPath.js
@@ -13,8 +13,9 @@ import combineURLs from '../helpers/combineURLs.js';
  *
  * @returns {string} The combined full path
  */
-export default function buildFullPath(baseURL, requestedURL) {
-  if (baseURL && !isAbsoluteURL(requestedURL)) {
+export default function buildFullPath(baseURL, requestedURL, allowAbsoluteUrls = true) {
+  const isRelativeUrl = !isAbsoluteURL(requestedURL);
+  if (baseURL && (isRelativeUrl || allowAbsoluteUrls === false)) {
     return combineURLs(baseURL, requestedURL);
   }
   return requestedURL;
diff --git a/lib/helpers/combineURLs.js b/lib/helpers/combineURLs.js
index 9f04f02..dd3884d 100644
--- a/lib/helpers/combineURLs.js
+++ b/lib/helpers/combineURLs.js
@@ -9,7 +9,13 @@
  * @returns {string} The combined URL
  */
 export default function combineURLs(baseURL, relativeURL) {
-  return relativeURL
-    ? baseURL.replace(/\/?\/$/, '') + '/' + relativeURL.replace(/^\/+/, '')
-    : baseURL;
+  if (!relativeURL) {
+    return baseURL;
+  }
+  const base = baseURL.replace(/\/+$/, '');
+  const rel = relativeURL.replace(/^\/+/, '');
+  if (!rel) {
+    return base + '/';
+  }
+  return base + '/' + rel;
 }
diff --git a/lib/helpers/isAbsoluteURL.js b/lib/helpers/isAbsoluteURL.js
index 4747a45..fabcb8f 100644
--- a/lib/helpers/isAbsoluteURL.js
+++ b/lib/helpers/isAbsoluteURL.js
@@ -11,5 +11,8 @@ export default function isAbsoluteURL(url) {
   // A URL is considered absolute if it begins with "<scheme>://" or "//" (protocol-relative URL).
   // RFC 3986 defines scheme name as a sequence of characters beginning with a letter and followed
   // by any combination of letters, digits, plus, period, or hyphen.
+  if (typeof url !== 'string') {
+    return false;
+  }
   return /^([a-z][a-z\d+\-.]*:)?\/\//i.test(url);
 }
